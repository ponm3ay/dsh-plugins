# dsh-plugins — 环境变量样板
#
# ⚠️ 这里全部是占位符，**不要**把真实密钥填进这个文件。
#
# 用法（推荐程度从高到低）：
#
#   1) 用户级环境变量（首选，不落文件、不参与云同步）
#      Windows:  setx MY_API_KEY "你的 key"        # 之后重开终端 / 重启 DSH 生效
#      macOS/Linux: export MY_API_KEY="你的 key"   # 建议写进 ~/.zshrc 之外的私密文件
#
#   2) DSH 凭证库（DSH 自己管理，插件用 apiKeyEnv 引用即可）
#      $DSH_HOME/.credentials.yaml
#
#   3) 本地 .env（仅调试用；已在 .gitignore 中，但**依然不要**把它放进同步盘）
#      cp .env.example .env  &&  编辑 .env
#
# 插件侧只认「变量名」，仓库里永远只出现引用名，不出现值。

# ── 模型服务商（按需启用，未用到的留空即可）─────────────────
# DeepSeek 官方
DEEPSEEK_API_KEY=

# 腾讯云 TokenHub（Hy 系列）
TOKENHUB_API_KEY=

# 千问云 / 阿里云百炼（OpenAI 兼容端点）
QIANWEN_API_KEY=
DASHSCOPE_API_KEY=

# 智谱 BigModel（GLM 系列，可作视觉模型端点）
BIGMODEL_GLM_API_KEY=

# 小米 MiMo
XIAOMI_API_KEY=

# ── 插件可能用到的一般性配置（**非密钥**，可以安全填写）─────
# 视觉模型端点：截图交给外部视觉模型时使用
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-5.3-flashx

# DSH 家目录（一般不用手填，DSH 会自己决定）
# DSH_HOME=
