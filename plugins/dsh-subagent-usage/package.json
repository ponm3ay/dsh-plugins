{
  "name": "dsh-subagent-usage",
  "version": "0.1.0",
  "description": "在每个会话（尤其是子代理会话）里显示：实际调用的模型、推理等级、token 消耗。不改 DSH 本体源码。",
  "license": "MIT",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "verify",
    "cordis.patch.yml",
    "entry.js",
    "build-client.mjs",
    "README.md",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node verify/fold-test.mjs && node verify/client-test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "token-usage",
    "observability"
  ],
  "author": "ponm3ay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponm3ay/dsh-plugins.git",
    "directory": "plugins/dsh-subagent-usage"
  },
  "homepage": "https://github.com/ponm3ay/dsh-plugins/tree/main/plugins/dsh-subagent-usage#readme",
  "bugs": {
    "url": "https://github.com/ponm3ay/dsh-plugins/issues"
  }
}
